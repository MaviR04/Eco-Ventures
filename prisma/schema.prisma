// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  category_id Int    @id @default(autoincrement())
  name        String @unique
  tours       Tour[] // A category can have many tours
}

model Tour {
  tour_id         Int     @id @default(autoincrement())
  title           String
  description     String? // The '?' makes the field optional
  available_slots Int
  price           Float
  category_id     Int

  category    Category    @relation(fields: [category_id], references: [category_id])
  images      TourImage[]
  itineraries Itinerary[]
  Booking     Booking[]
}

model TourImage {
  image_id  Int    @id @default(autoincrement())
  image_url String
  tour_id   Int

  tour Tour @relation(fields: [tour_id], references: [tour_id], onDelete: Cascade)
}

model Itinerary {
  itinerary_id    Int     @id @default(autoincrement())
  day_number      Int
  day_title       String?
  day_description String?
  tour_id         Int

  tour Tour @relation(fields: [tour_id], references: [tour_id], onDelete: Cascade)
}

model User {
  id               Int                @id @default(autoincrement())
  email            String             @unique
  passwordHash     String
  name             String?
  role             String             @default("user")
  refreshToken     String? // stored refresh token (hashed optional)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  Booking          Booking[]
  PushSubscription PushSubscription[]
}

model Booking {
  booking_id Int      @id @default(autoincrement())
  user_id    Int
  tour_id    Int
  createdAt  DateTime @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tour Tour @relation(fields: [tour_id], references: [tour_id], onDelete: Cascade)
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String @unique @db.VarChar(1024)
  p256dh    String
  auth      String
  userId    Int?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}
